    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst lista = response.data || []; \nconst { pagina, pageSize } = $(\"Set Page\").first().json;\n\nlet results = [];\n\nif (Array.isArray(lista) && lista.length > 0) {\n  results = lista.map((venda) => ({\n    json: {\n      id: venda.id,\n      pagina: pagina,\n      hasMorePages: lista.length === pageSize,\n      totalItemsInPage: lista.length\n    }\n  }));\n} else {\n  results = [{ \n    json: { \n      id: null, \n      pagina: pagina, \n      hasMorePages: false, \n      totalItemsInPage: 0 \n    } \n  }];\n}\n\nreturn results;"
      },
