      "id": "87701d6a-92f5-4973-87d7-41c4c3fe64cc",
      "name": "Split Order Items"
    },
    {
      "parameters": {
        "jsCode": "const entradas = $input.all();\nconst todasLinhas = [];\n\nfor (const entrada of entradas) {\n  const pedido = entrada.json.data;\n  const item = entrada.json[\"data.itens\"];\n\n  if (!pedido || !item || !item.codigo) continue;\n\n  const frete = pedido.transporte?.frete ?? 0;\n  const descontoPedido = pedido.desconto?.valor ?? 0;\n  const outrasDespesas = pedido.outrasDespesas ?? 0;\n  const totalItens = pedido.itens?.length ?? 1;\n\n  const valorTotalLinha = item.quantidade * item.valor;\n  const participacao = pedido.totalProdutos > 0\n    ? valorTotalLinha / pedido.totalProdutos\n    : 1 / totalItens;\n\n  todasLinhas.push({\n    json: {\n      \"Data\":            pedido.data,\n      \"ID Venda\":        pedido.id,\n      \"ID Item Venda\":   String(item.id),\n      \"numeroLoja\":      pedido.numeroLoja,\n      \"ID Produto\":      item.produto?.id,\n      \"Codigo\":          item.codigo,\n      \"Descricao\":       item.descricao,\n      \"Qtde\":            item.quantidade,\n      \"Qtde faturada\":   item.quantidade,\n      \"Preço Medio\":     item.valor,\n      \"Valor\":           +valorTotalLinha.toFixed(2),\n      \"Valor faturado\":  +valorTotalLinha.toFixed(2),\n      \"Frete\":           +(frete * participacao).toFixed(2),\n      \"Desconto\":        +(item.desconto + (descontoPedido * participacao)).toFixed(2),\n      \"Outras despesas\": +(outrasDespesas * participacao).toFixed(2),\n      \"Total Venda\":     +(valorTotalLinha + (frete * participacao) - (descontoPedido * participacao) + (outrasDespesas * participacao)).toFixed(2)\n    }\n  });\n}\n\nreturn todasLinhas;"
      },
